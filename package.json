{
  "name": "saku-wechat-compiler",
  "version": "0.2.7",
  "private": true,
  "description": "Offline Markdown-compatible layout editor for WeChat Official Accounts",
  "author": "SakuWechatCompiler contributors",
  "license": "MIT",
  "packageManager": "pnpm@11.19.0",
  "type": "module",
  "main": "./out/main/main.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "package:mac": "pnpm build && electron-builder --mac --arm64"
  },
  "build": {
    "appId": "com.saku.wechatcompiler",
    "productName": "SakuWechatCompiler",
    "asar": true,
    "directories": {
      "output": "dist"
    },
    "files": [
      "out/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "resources/urbancomp-logo.png",
        "to": "urbancomp-logo.png"
      },
      {
        "from": "resources/app-icon-1024.png",
        "to": "app-icon-1024.png"
      }
    ],
    "mac": {
      "category": "public.app-category.productivity",
      "icon": "resources/app-icon-1024.png",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64"
          ]
        }
      ]
    }
  },
  "dependencies": {
    "@tiptap/core": "^3.30.1",
    "@tiptap/extension-color": "^3.30.1",
    "@tiptap/extension-font-family": "^3.30.1",
    "@tiptap/extension-text-align": "^3.30.1",
    "@tiptap/extension-text-style": "^3.30.1",
    "@tiptap/extension-underline": "^3.30.1",
    "@tiptap/react": "^3.30.1",
    "@tiptap/starter-kit": "^3.30.1",
    "mammoth": "^1.12.1",
    "marked": "^18.0.9",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "turndown": "^7.2.4"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@types/turndown": "^5.0.6",
    "@vitejs/plugin-react": "^6.0.5",
    "electron": "^43.4.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "jsdom": "^30.0.1",
    "typescript": "^7.0.2",
    "vite": "^8.2.1",
    "vitest": "^4.1.10"
  }
}
